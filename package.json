{
  "name": "deposit-onboarding-portal",
  "version": "1.0.0",
  "description": "Deposit Relay - Playwright TypeScript automation",
  "scripts": {
    "clean": "rimraf test-results allure-results allure-report playwright-report",
    "pretest": "npm run clean",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:smoke": "playwright test --grep @smoke",
    "test:consumer": "playwright test --grep @consumer",
    "test:entity": "playwright test --grep @entity",
    "test:smoke:headed": "playwright test --grep @smoke --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}